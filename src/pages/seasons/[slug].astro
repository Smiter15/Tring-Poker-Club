---
import { supabase } from 'src/db/supabase';
import { getOrdinal } from 'src/utils';
import { buildSeasonProgress } from 'src/utils/seasonProgress';

import Layout from '@layouts/Layout.astro';
import Table from '@components/Table';
import SeasonLineChart from 'src/components/SeasonProgressLineChart';
import SeasonReplayLeaderboard from 'src/components/SeasonReplayLeaderboard';
import PlayerAvatar from '@components/PlayerAvatar';

import styles from '../../styles/detail.module.css';

// 1. Generate static paths for each season
export async function getStaticPaths() {
  const { data: seasons, error } = await supabase
    .from('seasons')
    .select('slug');

  if (error) {
    console.error('❌ Failed to load season slugs:', error);
    return [];
  }

  return seasons.map((s) => ({ params: { slug: s.slug } }));
}

// 2. Extract the slug parameter
const { slug } = Astro.params as { slug: string };

// 3. Load season metadata
const { data: season, error: seasonError } = await supabase
  .from('seasons')
  .select('id, name, is_active')
  .eq('slug', slug)
  .single();

if (seasonError || !season) {
  console.error('❌ Could not load season:', seasonError);
  throw new Error('Season not found');
}
const seasonId = season.id;

// 4. Load games for this season
const { data: rawGames, error: gamesError } = await supabase
  .from('games')
  .select(
    `
    id,
    slug,
    season_game,
    played_on,
    no_of_players,
    winner:players!games_winner_id_fkey (
      first_name,
      nickname,
      prefer_nickname,
      slug,
      image_url
    )
  `,
  )
  .eq('season_id', seasonId)
  .order('season_game', { ascending: true });

if (gamesError || !rawGames) {
  console.error('❌ Could not load games:', gamesError);
  throw new Error('Games not found');
}

// 5. Load season results (standings)
const { data: rawResults, error: resultsError } = await supabase
  .from('season_results')
  .select(
    `
    place,
    points,
    player:players!season_results_player_id_fkey (
      id,
      first_name,
      nickname,
      prefer_nickname,
      slug,
      image_url
    )
  `,
  )
  .eq('season_id', seasonId)
  .order('place', { ascending: true });

if (resultsError || !rawResults) {
  console.error('❌ Could not load season results:', resultsError);
  throw new Error('Season results not found');
}

// Load every result through its parent game, including seasons exceeding the API row limit.
const allGameResults: any[] = [];
if (rawGames.length > 0) {
  for (let offset = 0; ; offset += 500) {
    const { data, error } = await supabase
      .from('game_results')
      .select(
        `player_id, place, game_id, points,
        player:players!game_results_player_id_fkey(
          id, first_name, nickname, prefer_nickname, image_url
        )`,
      )
      .in(
        'game_id',
        rawGames.map((game) => game.id),
      )
      .order('game_id')
      .order('player_id')
      .range(offset, offset + 499);

    if (error || !data) {
      console.error('❌ Could not load game results:', error);
      throw new Error('Game results not found');
    }
    allGameResults.push(...data);
    if (data.length < 500) break;
  }
}

const gameOrder = new Map(rawGames.map((game, index) => [game.id, index]));
allGameResults.sort(
  (a, b) => gameOrder.get(a.game_id)! - gameOrder.get(b.game_id)!,
);

// Determine max place per game for 'last place' emoji
const maxPlaceByGame: Record<number, number> = {};
allGameResults.forEach(({ game_id, place }) => {
  maxPlaceByGame[game_id] = Math.max(maxPlaceByGame[game_id] || 0, place);
});

// Build emoji sequences per player across games
const emojisByPlayerId: Record<number, string> = {};
allGameResults.forEach(({ player_id, place, game_id }) => {
  if (!emojisByPlayerId[player_id]) emojisByPlayerId[player_id] = '';
  if (place === 1) emojisByPlayerId[player_id] += '🥇';
  else if (place === 2) emojisByPlayerId[player_id] += '🥈';
  else if (place === 3) emojisByPlayerId[player_id] += '🥉';
  else if (place === 4) emojisByPlayerId[player_id] += '🫧';
  else if (place === maxPlaceByGame[game_id])
    emojisByPlayerId[player_id] += '💩';
});

// Helper to format date as dd/mm/yy
const formatDate = (iso: string) => {
  const d = new Date(iso);
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const yy = String(d.getFullYear()).slice(-2);
  return `${dd}/${mm}/${yy}`;
};

// Map rawGames into display-friendly shape
const games = rawGames.map((g: any) => ({
  id: g.id,
  slug: g.slug,
  seasonGame: g.season_game,
  date: formatDate(g.played_on),
  numberOfPlayers: g.no_of_players,
  winnerFirstName: g.winner?.prefer_nickname
    ? g.winner.nickname
    : (g.winner?.first_name ?? 'Result pending'),
  winnerSlug: g.winner?.slug ?? '',
  winnerImage: g.winner?.image_url ?? '',
}));

// Build tableData with average points per game
const tableData = rawResults.map((r: any) => {
  const playerId = r.player.id;
  const numGames = allGameResults.filter(
    (result) => result.player_id === playerId,
  ).length;
  const pts = r.points;
  const avgPoints = numGames > 0 ? parseFloat((pts / numGames).toFixed(2)) : 0;

  return {
    place: getOrdinal(r.place),
    placeNum: r.place, // ✅ NEW: numeric place from season_results (tie-aware)
    name: r.player.prefer_nickname ? r.player.nickname : r.player.first_name,
    playerSlug: r.player.slug,
    playerImage: r.player.image_url,
    games: numGames,
    avgPoints,
    points: pts,
    emojis: emojisByPlayerId[playerId] || '',
  };
});

// Prepare games table rows
const gamesTableData = games.map((g) => ({
  game: g.seasonGame,
  date: g.date,
  numberOfPlayers: g.numberOfPlayers,
  winner: g.winnerFirstName,
  playerSlug: g.winnerSlug,
  playerImage: g.winnerImage,
  navigate: `/games/${g.slug}`,
}));

const metaByLabel = Object.fromEntries(
  tableData.map((r) => [
    r.name,
    { games: r.games, avgPoints: r.avgPoints, emojis: r.emojis },
  ]),
);

// ✅ NEW: tie-aware final place map (1,2,2,4 etc)
const placeByLabel = Object.fromEntries(
  tableData.map((r) => [r.name, r.placeNum]),
);

// Both the replay and cumulative chart use the same database game history.
// Include participants even if a season standing has not been created for them yet.
const progressPlayers = new Map<number, any>();
rawResults.forEach((result: any) =>
  progressPlayers.set(result.player.id, result.player),
);
allGameResults.forEach((result) =>
  progressPlayers.set(result.player.id, result.player),
);
const { labels: dateLabels, datasets } = buildSeasonProgress(
  rawGames,
  allGameResults,
  [...progressPlayers.values()].map((player) => ({
    id: player.id,
    label: player.prefer_nickname ? player.nickname : player.first_name,
    avatarUrl: player.image_url,
  })),
);

const leader = tableData[0];
---

<Layout title={`Season ${season.name}`}>
  <header class={styles.hero}>
    <div class="content-shell">
      <a class={styles.breadcrumb} href="/seasons"
        ><span aria-hidden="true">←</span> All seasons</a
      >
      <div class={styles.heroGrid}>
        <div>
          <p class={styles.heroKicker}>
            {season.is_active ? 'Current season' : 'Season archive'}
          </p>
          <h1>Season {season.name}</h1>
          <p class={styles.heroMeta}>
            {
              season.is_active
                ? 'The race is still on.'
                : 'Final standings and every game from the season.'
            }
          </p>
        </div>
        <div class={styles.heroStats}>
          <div><strong>{rawGames.length}</strong><span>Games</span></div>
          <div><strong>{tableData.length}</strong><span>Players</span></div>
          <div>
            <strong>{leader?.points ?? 0}</strong><span>Lead points</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class={`content-shell ${styles.content}`}>
    {
      leader && (
        <section>
          <div class={styles.sectionHeader}>
            <h2>{season.is_active ? 'Current leader' : 'Season champion'}</h2>
          </div>
          <a class={styles.winnerCard} href={`/players/${leader.playerSlug}`}>
            <PlayerAvatar
              displayName={leader.name}
              imageUrl={leader.playerImage}
              size="lg"
              champion
              celebrate
            />
            <div>
              <>
                <small>
                  {season.is_active ? 'Leading the table' : 'Champion'}
                </small>
                <strong>{leader.name}</strong>
                <span>
                  {leader.points} points · {leader.games} games
                </span>
              </>
            </div>
            <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }

    <section>
      <div class={styles.sectionHeader}>
        <h2>{season.is_active ? 'Live standings' : 'Final standings'}</h2><p>
          Choose a game to replay the table
        </p>
      </div>
      <div class={`${styles.panel} ${styles.chartPanel}`}>
        <SeasonReplayLeaderboard
          client:only="react"
          labels={dateLabels}
          datasets={datasets}
          metaByLabel={metaByLabel}
          placeByLabel={placeByLabel}
        />
      </div>
    </section>

    <section>
      <div class={styles.sectionHeader}>
        <h2>Cumulative points</h2><p>How the race changed week by week</p>
      </div>
      <div class={`${styles.panel} ${styles.chartPanel}`}>
        <SeasonLineChart
          client:only="react"
          labels={dateLabels}
          datasets={datasets}
        />
      </div>
    </section>

    <section>
      <div class={styles.sectionHeader}>
        <h2>Games</h2><p>{gamesTableData.length} results</p>
      </div>
      <Table
        client:only="react"
        data={gamesTableData}
        mobileHiddenFields={['date']}
      />
    </section>
  </div>
</Layout>
