---
import Layout from '../../../layouts/Layout.astro';
import ResultsAdmin from '../../../components/ResultsAdmin';
import styles from './_addGame.module.css';
---

<Layout
  title="Manage results"
  description="Record and correct Tring Poker Club game results."
>
  <header class="page-hero">
    <div class="content-shell">
      <p class="page-kicker">Club admin</p>
      <h1 class={`page-title ${styles.headerTitle}`}>Manage results</h1>
      <p class={`page-intro ${styles.headerIntro}`}>
        Record the night’s knockouts. We’ll take care of the final table and
        points.
      </p>
    </div>
  </header>
  <div class={styles.container}><ResultsAdmin client:only="react" /></div>
  <div class={styles.container} style="padding-top: 0">
    <a href="/add/player">Need a new player for a game? Add them here →</a>
  </div>
</Layout>
