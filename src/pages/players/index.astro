---
import { supabase } from 'src/db/supabase';
import Layout from '@layouts/Layout.astro';
import PlayerDirectory from '@components/PlayerDirectory';
import styles from '../../styles/collections.module.css';

const [
  { data: rawPlayers, error },
  { data: allResults, error: resultsError },
  { data: seasons, error: seasonsError },
] = await Promise.all([
  supabase
    .from('players')
    .select(
      `
    id, slug, first_name, last_name, image_url, nickname
  `,
    )
    .order('first_name', { ascending: true }),
  supabase.from('game_results').select('player_id, place'),
  supabase.from('seasons').select('winner_id'),
]);

if (error) throw new Error(`Could not load players: ${error.message}`);
if (resultsError)
  throw new Error(`Could not load player stats: ${resultsError.message}`);
if (seasonsError)
  throw new Error(`Could not load season champions: ${seasonsError.message}`);

const statsByPlayer = (allResults ?? []).reduce(
  (
    stats: Record<number, { gamesPlayed: number; wins: number }>,
    result: any,
  ) => {
    const playerStats = stats[result.player_id] ?? { gamesPlayed: 0, wins: 0 };
    playerStats.gamesPlayed += 1;
    if (Number(result.place) === 1) playerStats.wins += 1;
    stats[result.player_id] = playerStats;
    return stats;
  },
  {},
);

const seasonWinsByPlayer = (seasons ?? []).reduce(
  (wins: Record<number, number>, season: any) => {
    if (season.winner_id) {
      wins[season.winner_id] = (wins[season.winner_id] ?? 0) + 1;
    }
    return wins;
  },
  {},
);

const players = (rawPlayers ?? []).map((player: any) => ({
  slug: player.slug,
  firstName: player.first_name ?? '',
  lastName: player.last_name ?? '',
  nickname: player.nickname,
  imageUrl: player.image_url,
  gamesPlayed: statsByPlayer[player.id]?.gamesPlayed ?? 0,
  wins: statsByPlayer[player.id]?.wins ?? 0,
  seasonWins: seasonWinsByPlayer[player.id] ?? 0,
}));
---

<Layout
  title="Players"
  description="Meet the players and explore Tring Poker Club stats, wins and results."
>
  <header class="page-hero">
    <div class="content-shell">
      <p class="page-kicker">Meet the table</p>
      <h1 class={`page-title ${styles.headerTitle}`}>Players</h1>
      <p class={`page-intro ${styles.headerIntro}`}>
        {players.length} regulars, rivals and Wednesday night champions. Pick a player
        to explore their full record.
      </p>
    </div>
  </header>

  <section class={`content-shell ${styles.collectionSection}`}>
    <PlayerDirectory client:load players={players} />
  </section>
</Layout>
