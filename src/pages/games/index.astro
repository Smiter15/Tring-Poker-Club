---
import { supabase } from 'src/db/supabase';
import Layout from '@layouts/Layout.astro';
import PlayerAvatar from '@components/PlayerAvatar';
import styles from '../../styles/collections.module.css';

const { data: rawGames, error } = await supabase
  .from('games')
  .select(
    `
  slug, season_id, season_game, played_on, no_of_players,
  winner:players!games_winner_id_fkey(first_name, last_name, nickname, prefer_nickname, slug, image_url)
`,
  )
  .order('season_id', { ascending: false })
  .order('season_game', { ascending: false });

if (error) throw new Error(`Could not load games: ${error.message}`);

const gamesBySeason = (rawGames ?? []).reduce(
  (groups: Record<string, any[]>, game: any) => {
    (groups[game.season_id] ||= []).push(game);
    return groups;
  },
  {},
);
const seasonIds = Object.keys(gamesBySeason).sort(
  (a, b) => Number(b) - Number(a),
);
const displayName = (player: any) =>
  !player
    ? 'Result pending'
    : player.prefer_nickname && player.nickname
      ? player.nickname
      : player.first_name;
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(new Date(iso));
---

<Layout
  title="Games"
  description="Browse every Tring Poker Club game, winner and result."
>
  <header class="page-hero">
    <div class="content-shell">
      <p class="page-kicker">Every deal counts</p>
      <h1 class={`page-title ${styles.headerTitle}`}>Games</h1>
      <p class={`page-intro ${styles.headerIntro}`}>
        Results from every Wednesday night game, from the latest showdown back
        to where the league began.
      </p>
    </div>
  </header>

  <div class={`content-shell ${styles.collectionSection}`}>
    {
      seasonIds.length > 0 ? (
        seasonIds.map((seasonId, groupIndex) => (
          <section class={styles.seasonGroup}>
            <div class={styles.groupHeading}>
              <h2>Season {seasonId}</h2>
              <span>
                {groupIndex === 0 ? 'Current season · ' : ''}
                {gamesBySeason[seasonId].length} games
              </span>
            </div>
            <div class={styles.gameGrid}>
              {gamesBySeason[seasonId].map((game: any) => (
                <a
                  class={`card card-link ${styles.gameCard}`}
                  href={`/games/${game.slug}`}
                >
                  <div class={styles.gameTop}>
                    <span>Game {game.season_game}</span>
                    <span>{formatDate(game.played_on)}</span>
                  </div>
                  <h3>Game {game.season_game}</h3>
                  <div class={styles.gameWinner}>
                    <PlayerAvatar
                      firstName={game.winner?.first_name}
                      lastName={game.winner?.last_name}
                      displayName={displayName(game.winner)}
                      imageUrl={game.winner?.image_url}
                      size="sm"
                      champion={Boolean(game.winner)}
                    />
                    <div>
                      <small>{game.winner ? 'Winner' : 'Result'}</small>
                      <strong>{displayName(game.winner)}</strong>
                    </div>
                  </div>
                  <div class={styles.gameBottom}>
                    <span>{game.no_of_players ?? 0} players</span>
                    <span aria-hidden="true">→</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      ) : (
        <div class={`card ${styles.empty}`}>No games have been added yet.</div>
      )
    }
  </div>
</Layout>
