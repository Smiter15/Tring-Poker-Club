---
import './Layout.module.css';
import '../styles/global.css';

const {
  title,
  description = 'Friendly, competitive Wednesday night poker in Tring.',
} = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Seasons', href: '/seasons' },
  { label: 'Games', href: '/games' },
  { label: 'Players', href: '/players' },
];
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191c2d" />
    <meta
      name="format-detection"
      content="telephone=no,date=no,address=no,email=no"
    />
    <link rel="icon" type="image/png" href="/images/TPC-logo-round.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800;9..144,900&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>
      {title === 'Home' ? 'Tring Poker Club' : `${title} | Tring Poker Club`}
    </title>
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <header class="site-header">
        <div class="header-inner">
          <a href="/" class="brand" aria-label="Tring Poker Club home">
            <span class="brand-mark" aria-hidden="true">♠</span>
            <span class="brand-copy"
              ><strong>Tring</strong><small>Poker Club</small></span
            >
          </a>

          <button
            class="menu-button"
            type="button"
            aria-expanded="false"
            aria-controls="site-navigation"
          >
            <span class="visually-hidden">Toggle navigation</span>
            <span aria-hidden="true"></span><span aria-hidden="true"
            ></span><span aria-hidden="true"></span>
          </button>

          <nav
            id="site-navigation"
            class="site-nav"
            aria-label="Main navigation"
          >
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive(item.href) }]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a href="/#join" class="nav-cta"
              >Join the club <span aria-hidden="true">→</span></a
            >
          </nav>
        </div>
      </header>

      <main id="main-content" class="site-main"><slot /></main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div>
            <div class="footer-brand">
              <span aria-hidden="true">♠</span> Tring Poker Club
            </div>
            <p>Friendly Wednesday night poker at The Con Club, Tring.</p>
          </div>
          <div class="footer-links" aria-label="Footer navigation">
            <a href="/seasons">Seasons</a>
            <a href="/games">Games</a>
            <a href="/players">Players</a>
            <a href="mailto:tringpoker@gmail.com">Email us</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Tring Poker Club</span>
          <span>Built by Matt 2</span>
        </div>
      </footer>
    </div>

    <script>
      const menuButton = document.querySelector('.menu-button');
      const navigation = document.querySelector('#site-navigation');
      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        navigation?.classList.toggle('open', !isOpen);
      });
    </script>
  </body>
</html>
